# ── Secrets & Credentials ────────────────────────────────────
.env
.env.*
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
secrets/
credentials/

# ── Obsidian local files (not for sharing) ───────────────────
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/cache
.obsidian/plugins/
# Keep: .obsidian/templates/ — shared templates ARE committed

# ── OS & Editor ──────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*.swo
.vscode/settings.json

# ── Node ─────────────────────────────────────────────────────
node_modules/
npm-debug.log

# ── Private drafts (prefix file with _ to keep local only) ───
signals/_*
projects/_*
concepts/_*

# ── Build artifacts (docs/ is committed — it IS the site) ────
# docs/ is intentionally NOT ignored
