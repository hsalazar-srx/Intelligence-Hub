#!/usr/bin/env bash
# =============================================================================
# IT-Strategy — Pre-commit Sensitive Data Guard
# Blocks commits containing patterns that suggest sensitive/internal data.
# Install: cp .github/hooks/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit
# =============================================================================

RED='\033[0;31m'
YELLOW='\033[1;33m'
GREEN='\033[0;32m'
NC='\033[0m'

echo "🔍 Running sensitive data scan..."

VIOLATIONS=0
WARNINGS=0

STAGED=$(git diff --cached --name-only --diff-filter=ACM)

if [ -z "$STAGED" ]; then
  echo -e "${GREEN}✓ No staged files to scan.${NC}"
  exit 0
fi

BLOCK_PATTERNS=(
  "password\s*[:=]\s*\S+"
  "passwd\s*[:=]\s*\S+"
  "secret\s*[:=]\s*\S+"
  "api[_-]?key\s*[:=]\s*\S+"
  "access[_-]?token\s*[:=]\s*\S+"
  "private[_-]?key"
  "BEGIN (RSA|EC|OPENSSH|PGP) PRIVATE KEY"
  "ghp_[A-Za-z0-9]{36}"
  "sk-[A-Za-z0-9]{48}"
  "AKIA[0-9A-Z]{16}"
  "192\.168\.[0-9]{1,3}\.[0-9]{1,3}"
  "10\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}"
  "172\.(1[6-9]|2[0-9]|3[0-1])\.[0-9]{1,3}\.[0-9]{1,3}"
  "jdbc:[a-z]+://"
  "mongodb(\+srv)?://"
  "Server=[^;]+;Database=[^;]+;User"
)

WARN_PATTERNS=(
  "\b[A-Z]{2,10}-[0-9]{4,}\b"
  "@[a-zA-Z0-9._%+-]+\.[a-zA-Z]{2,4}"
  "\b\d{3}[-.]?\d{3}[-.]?\d{4}\b"
  "\\\\[A-Z]{2,15}\\\\"
)

for FILE in $STAGED; do
  if [[ "$FILE" == ".github/hooks/"* ]] || [[ "$FILE" == ".github/workflows/"* ]] || [[ "$FILE" == ".gitignore" ]]; then
    continue
  fi

  CONTENT=$(git show ":$FILE" 2>/dev/null)

  for PATTERN in "${BLOCK_PATTERNS[@]}"; do
    MATCH=$(echo "$CONTENT" | grep -inE "$PATTERN" | head -3)
    if [ -n "$MATCH" ]; then
      echo -e "${RED}❌ BLOCKED — Sensitive pattern in: $FILE${NC}"
      echo -e "${RED}   Pattern: $PATTERN${NC}"
      VIOLATIONS=$((VIOLATIONS + 1))
    fi
  done

  for PATTERN in "${WARN_PATTERNS[@]}"; do
    MATCH=$(echo "$CONTENT" | grep -inE "$PATTERN" | head -1)
    if [ -n "$MATCH" ]; then
      echo -e "${YELLOW}⚠️  WARNING — Review: $FILE → $PATTERN${NC}"
      WARNINGS=$((WARNINGS + 1))
    fi
  done
done

if [ $VIOLATIONS -gt 0 ]; then
  echo -e "${RED}🚫 Commit BLOCKED — $VIOLATIONS sensitive pattern(s) found.${NC}"
  echo -e "${RED}   Use 'git commit --no-verify' only if you are certain this is a false positive.${NC}"
  exit 1
fi

if [ $WARNINGS -gt 0 ]; then
  echo -e "${YELLOW}⚠️  $WARNINGS warning(s). Commit allowed — review before pushing publicly.${NC}"
fi

echo -e "${GREEN}✓ Scan passed.${NC}"
exit 0
