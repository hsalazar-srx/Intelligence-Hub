#!/usr/bin/env bash
# =============================================================================
# IT-Strategy — Pre-commit Sensitive Data Guard
# Blocks commits that contain actual hardcoded credentials or internal infra refs.
# Install: cp .github/hooks/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit
# =============================================================================

RED='\033[0;31m'
YELLOW='\033[1;33m'
GREEN='\033[0;32m'
NC='\033[0m'

echo "Running sensitive data scan..."

VIOLATIONS=0
WARNINGS=0

STAGED=$(git diff --cached --name-only --diff-filter=ACM)

if [ -z "$STAGED" ]; then
  echo -e "${GREEN}No staged files to scan.${NC}"
  exit 0
fi

# Lines containing these strings are always safe (env var refs, placeholders)
SAFE_PATTERN='os\.environ|getenv|secrets\.|YOUR_KEY|REPLACE_ME|placeholder'

# Files to skip entirely
skip_file() {
  local f="$1"
  [[ "$f" == .github/hooks/* ]]     && return 0
  [[ "$f" == .github/workflows/* ]] && return 0
  [[ "$f" == scripts/build.py ]]    && return 0
  [[ "$f" == scripts/build.js ]]    && return 0
  [[ "$f" == .gitignore ]]          && return 0
  return 1
}

check() {
  local content="$1"
  local pattern="$2"
  echo "$content" | grep -inE "$pattern" | grep -ivE "$SAFE_PATTERN" | head -3
}

for FILE in $STAGED; do
  if skip_file "$FILE"; then
    continue
  fi

  CONTENT=$(git show ":$FILE" 2>/dev/null)

  # Private key headers
  if check "$CONTENT" 'BEGIN (RSA|EC|OPENSSH|PGP) PRIVATE KEY' | grep -q .; then
    echo -e "${RED}BLOCKED [$FILE] - Private key detected${NC}"
    VIOLATIONS=$((VIOLATIONS + 1))
  fi

  # GitHub PAT
  if check "$CONTENT" 'ghp_[A-Za-z0-9]{36}' | grep -q .; then
    echo -e "${RED}BLOCKED [$FILE] - GitHub PAT token${NC}"
    VIOLATIONS=$((VIOLATIONS + 1))
  fi

  # AWS key
  if check "$CONTENT" 'AKIA[0-9A-Z]{16}' | grep -q .; then
    echo -e "${RED}BLOCKED [$FILE] - AWS Access Key${NC}"
    VIOLATIONS=$((VIOLATIONS + 1))
  fi

  # Anthropic key value (actual key, 95+ chars starting with sk-ant-api)
  if check "$CONTENT" 'sk-ant-api[0-9A-Za-z_-]{50,}' | grep -q .; then
    echo -e "${RED}BLOCKED [$FILE] - Anthropic API key value${NC}"
    VIOLATIONS=$((VIOLATIONS + 1))
  fi

  # OpenAI key value
  if check "$CONTENT" 'sk-[a-zA-Z0-9]{20}T3BlbkFJ[a-zA-Z0-9]{20}' | grep -q .; then
    echo -e "${RED}BLOCKED [$FILE] - OpenAI API key value${NC}"
    VIOLATIONS=$((VIOLATIONS + 1))
  fi

  # JDBC connection string with actual host
  if check "$CONTENT" 'jdbc:[a-z]+://[a-zA-Z0-9]' | grep -q .; then
    echo -e "${RED}BLOCKED [$FILE] - JDBC connection string${NC}"
    VIOLATIONS=$((VIOLATIONS + 1))
  fi

  # MongoDB URI with actual host
  if check "$CONTENT" 'mongodb\+?s?r?v?://[a-zA-Z0-9]' | grep -q .; then
    echo -e "${RED}BLOCKED [$FILE] - MongoDB URI${NC}"
    VIOLATIONS=$((VIOLATIONS + 1))
  fi

  # SQL Server connection string
  if check "$CONTENT" 'Server=[a-zA-Z0-9].*Database=.*User' | grep -q .; then
    echo -e "${RED}BLOCKED [$FILE] - SQL Server connection string${NC}"
    VIOLATIONS=$((VIOLATIONS + 1))
  fi

  # Private IPs
  if check "$CONTENT" '192\.168\.[0-9]{1,3}\.[0-9]{1,3}' | grep -q .; then
    echo -e "${RED}BLOCKED [$FILE] - Private IP 192.168.x.x${NC}"
    VIOLATIONS=$((VIOLATIONS + 1))
  fi

  if check "$CONTENT" '10\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}' | grep -q .; then
    echo -e "${RED}BLOCKED [$FILE] - Private IP 10.x.x.x${NC}"
    VIOLATIONS=$((VIOLATIONS + 1))
  fi

  # Warn on email addresses
  if echo "$CONTENT" | grep -inE '@[a-zA-Z0-9._%+-]+\.[a-zA-Z]{2,4}' | grep -ivE "$SAFE_PATTERN" | grep -q .; then
    echo -e "${YELLOW}WARNING [$FILE] - Email address found. Intentional?${NC}"
    WARNINGS=$((WARNINGS + 1))
  fi

done

if [ $VIOLATIONS -gt 0 ]; then
  echo ""
  echo -e "${RED}Commit BLOCKED - $VIOLATIONS issue(s) found.${NC}"
  echo -e "${RED}Fix issues above, or use: git commit --no-verify (only if certain it is a false positive)${NC}"
  exit 1
fi

if [ $WARNINGS -gt 0 ]; then
  echo -e "${YELLOW}$WARNINGS warning(s) - commit allowed, review before pushing.${NC}"
fi

echo -e "${GREEN}Scan passed - commit approved.${NC}"
exit 0
